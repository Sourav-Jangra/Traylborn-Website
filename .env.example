# Copy to .env.local for local development and fill in the values.
# Never commit real values.

# MariaDB 11.8+ or MySQL 8+ connection. DATABASE_PORT defaults to 3306.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks). Use rzp_test_ keys
# everywhere except production. The webhook URL is https://<site>/api/webhooks/razorpay
# with the events payment.authorized, payment.captured, payment.failed and order.paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Number of reverse proxies in front of the app that append to X-Forwarded-For. Defaults
# to 1 (Hostinger Web Apps). The visitor IP feeds sign-in, booking and coupon rate limits:
# confirm on staging that bookings.created_ip holds your real public IP, and that sending
# your own X-Forwarded-For header doesn't change it. 0 ignores the header (no rate limits by IP).
TRUSTED_PROXY_COUNT=

# Cloudinary cloud name (Dashboard → Product environment). Public, not a secret. Lets the
# media library add images/videos by their res.cloudinary.com delivery URL. Needed at build
# time as well as at runtime.
CLOUDINARY_CLOUD_NAME=
